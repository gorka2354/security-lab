# external cloned target repos (third-party code, large — not ours to vendor)
hunts/*/protocol/
hunts/*/contracts/

# foundry build artifacts / deps
**/lib/
**/out/
**/cache/
**/artifacts/
**/foundry.lock

# generated reports
**/recon-report.md
**/report.md

# python
__pycache__/
*.pyc
*.pyo

# secrets — never commit
.env
.env.*
!.env.example

# volume-engine cloned targets + generated queue
hunts/_volume/

# fetch_source.py output (deployed verified source pulled by address — third-party)
fetched/

# transient session artifacts
.playwright-mcp/
scout-worklist.json

# contest-watch runtime state (machine-local: seen-state, alert log, last-scan log)
monitor/

# macOS
.DS_Store
.gstack/

# radar/monitor runtime state (auto-generated; kept out of history to avoid churn commits)
hunts/_radar/
monitor/*-seen.json
# decompile/bytecode scratch dumps (derived, regenerable)
hunts/**/_*.txt
hunts/**/_*.hex
hunts/**/_*/

# crash dumps
*.stackdump

# Claude Code local config (kept local; not part of the tool-agnostic showcase)
.claude/

# authorized-scope layer cache (regenerate: programs.py fetch)
monitor/programs.json

# disclosure letter drafts (working docs; may hold pre-disclosure detail) -- local/stand-only, like inc/
*-poc/DISCLOSURE.md
/disclosures/
